# Copy to .streamlit/secrets.toml for local use, or paste into the Streamlit Cloud app's Secrets box.
TURSO_DATABASE_URL = "https://your-database-name-yourorg.turso.io"
TURSO_AUTH_TOKEN = "your-turso-token"
# The public address of the deployed app (no trailing slash). Used to build every link and QR code.
APP_BASE_URL = "https://your-app-name.streamlit.app"
# Any long random text. Set it once and NEVER change it (changing it lets students evaluate again).
EMAIL_HASH_SALT = "replace-with-a-long-random-text"
